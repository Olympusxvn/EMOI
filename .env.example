# Copy to .env and fill in real values. NEVER commit .env.
# Public account IDs (not secrets) are pre-filled; keys stay empty here.
NEAR_NETWORK=testnet
OWNER_ACCOUNT_ID=emoi.testnet
POLICY_CONTRACT_ID=policy.emoi.testnet
AGENT_ACCOUNT_ID=agent.emoi.testnet
# Owner full-access key, used only by local scripts (create/register/deposit/set policy).
# Never use it in the agent service or the frontend.
OWNER_PRIVATE_KEY=
# Agent Function Call Key private key (agent service only, never the owner full key)
AGENT_FCK_PRIVATE_KEY=
# Optional NEAR AI Cloud key (env-gated LLM layer; demo runs parser-only without it)
NEAR_AI_CLOUD_API_KEY=
# Dedicated research agent id (Research slice only)
RESEARCH_AGENT_ID=research.emoi.testnet
# NEAR AI Cloud model for intent parsing + report generation
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1
# Agent service port (default 3001)
AGENT_SERVICE_PORT=3001
